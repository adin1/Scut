# --- AI (optional) ---------------------------------------------------------
# Victim data is special-category data (GDPR art. 9). By default AI runs only
# through Vertex AI in an EU region; without it, SCUT answers from the national
# crisis protocols.
GOOGLE_GENAI_USE_VERTEXAI="true"
GOOGLE_CLOUD_PROJECT="MY_GCP_PROJECT"
GOOGLE_CLOUD_LOCATION="europe-west1"
# SCUT_AI_MODEL="gemini-2.5-flash"

# GEMINI_API_KEY (Gemini Developer API) has no EU data-residency guarantee.
# It is used only when SCUT_ALLOW_NON_EU_AI="true" (development only).
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# SCUT_ALLOW_NON_EU_AI="false"

# --- Institutional access ----------------------------------------------------
# JSON map of bearer tokens (at least 32 characters each) to staff identities.
# The audit ledger records the actor from the token, never from the request body.
# Without this variable every institutional endpoint answers 503.
SCUT_STAFF_TOKENS='{"REPLACE_WITH_A_LONG_RANDOM_TOKEN":{"actorId":"usr-police-01","actorRole":"police","actorInstitution":"IPJ Exemplu"}}'

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
